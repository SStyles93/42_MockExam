{
  "c": {
    "requires": ["cc"],
    "source_ext": ".c",
    "build": ["{cc}", "-Wall", "-Wextra", "-Werror", "{cflags}", "{sources}", "-o", "{bin}", "{ldflags}"],
    "object": ["{cc}", "-Wall", "-Wextra", "-Werror", "{cflags}", "-c", "{source}", "-o", "{obj}"],
    "run": ["{bin}", "{args}"],
    "symbol_check": true
  },
  "python": {
    "requires": [],
    "source_ext": ".py",
    "build": null,
    "run": ["{python}", "{main}", "{args}"],
    "symbol_check": false
  }
}
